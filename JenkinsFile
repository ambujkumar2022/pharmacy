pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'dev-pharmacy',
                    url: 'https://github.com/ambujkumar2022/pharmacy.git'
            }
        }

       /* stage('Frontend Build') {
            steps {
              dir('pharmacy-ui'){
                bat 'npm install'
                bat 'npm run build'
                }
            }
        }*/

       stage('Debug Sonar Token') {
            steps {
                bat 'echo Token Loaded Successfully'
            }
        }

        stage('Sonar Begin') {
            steps {
                bat '''C:\Users\ambuj\.dotnet\tools\dotnet-sonarscanner.exe begin /k:"pharmacy" /d:sonar.host.url="http://localhost:9000" /d:sonar.token="%SONAR_TOKEN%" /d:sonar.javascript.lcov.reportPaths="pharmacy-ui/coverage/lcov.info" '''
                }
         }

        stage('Build Backend') {
            steps {
                bat 'dotnet build'
            }
        }

        stage('Backend Tests') {
            steps {
                bat 'dotnet test --collect:"XPlat Code Coverage"'
            }
        }

       /* stage('Frontend Build') {
            steps {

                dir('pharmacy-ui') {

                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }*/

        stage('Frontend Tests') {

            steps {

                dir('pharmacy-ui') {

                    bat 'npm test -- --coverage --watchAll=false'
                }
            }
        }

        stage('Sonar End') {

            steps {

                bat '''dotnet sonarscanner end /d:sonar.token="%SONAR_TOKEN%"'''
            }
        }
    }

    post {
        success {
            echo 'Build Successful'
        }
        failure {
            echo 'Build Failed'
        }
    }
}