pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'dev-pharmacy',
                    url: 'https://github.com/ambujkumar2022/pharmacy.git'
            }
        }

        stage('Build') {
            steps {
                sh 'dotnet build'
            }
        }

        stage('Test') {
            steps {
                sh 'dotnet test'
            }
        }

        stage('Frontend Build') {
            steps {
                sh 'npm install'
                sh 'npm run build'
            }
        }
    }

    post {
        success {
            echo 'Build Successful'
        }
        failure {
            echo 'Build Failed'
        }
    }
}